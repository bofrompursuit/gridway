# Copy to .env for local configuration. Never add real credentials to this template.
# Public NYC street-segment data; no API key required for basic requests.
NYC_STREET_CENTERLINE_URL=https://data.cityofnewyork.us/resource/inkn-q76z.json

# Public NYC address search; no API key required.
NYC_GEOSEARCH_BASE_URL=https://geosearch.planninglabs.nyc/v2

# Public pedestrian router; documentation only for this static app.
WALKING_ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving/
